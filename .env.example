# Copy to .env for local-only use. Never commit .env or print credential values.

# Fixed local ports: frontend connects to Java 3381; Node 3382 is private.
SERVER_PORT=3381
SIDECAR_PORT=3382

# Customer gateway for real identity, observations and confirmed device control.
IOT_GATEWAY_BASE_URL=https://ncim.577119.com
IOT_GATEWAY_CALL_TIMEOUT_MS=15000
# Runtime-derived Office scope entry point; Java route migration expands this set.
IOT_GATEWAY_OFFICE_SCOPE_PATH=/micro-api/api/office/device/page
IOT_GATEWAY_COMPANY_SCOPE_PATH=/micro-api/api/iot-center/device/page
IOT_IDENTITY_VERIFY=true
IOT_IDENTITY_VERIFY_TIMEOUT_MS=15000
# Authentication is memory-only: first use after restart/eviction immediately returns
# ACCOUNT_IDENTITY_PREPARING (HTTP 503); only the real background account/me check can admit it.
# Verified credentials refresh in the background every minute; transient errors keep
# the held identity only until 24h after the last successful validation, then fail closed.
# Explicit upstream 401/403 revokes the held identity immediately on detection.
# Rejected-credential read snapshots are discarded across sources; successful later
# authentication must reacquire their data rather than expose pre-rejection results.
IOT_IDENTITY_REFRESH_INTERVAL_MS=60000
IOT_IDENTITY_MAX_VALIDATION_AGE_MS=86400000
IOT_IDENTITY_RETRY_COOLDOWN_MS=60000

# Use a random local-only value; the independent `agent-sidecar` must receive the same value.
AGENT_BRIDGE_TOKEN=<local-only-bridge-token>
AGENT_BRIDGE_BASE_URL=http://127.0.0.1:3382
AGENT_BRIDGE_RUN_TIMEOUT_MS=120000
AGENT_HEARTBEAT_MS=15000
JAVA_AGENT_TOOLS_URL=http://127.0.0.1:3381/internal/agent/tools
# Java authenticates both private callback routes with AGENT_BRIDGE_TOKEN.
JAVA_AGENT_TOOLS_TOKEN=<local-only-bridge-token>
JAVA_AGENT_SESSIONS_URL=http://127.0.0.1:3381/internal/agent/sessions

# Exact browser origin of the separately served video player page (scheme://host[:port]).
# Leave blank to keep cross-origin video playback closed; never use a wildcard.
AGENT_VIDEO_ALLOWED_ORIGIN=

# Model and observability settings are owned by the Java admin configuration
# store. Configure them through the console; the sidecar receives no bootstrap
# MODEL_*, LANGFUSE_* or AGENT_THINKING_LEVEL values from the environment.

# Production execution uses the real adapters. "fixture" is for isolated tests only.
AGENT_CONTROL_MODE=real

# Local MySQL / Redis compose services.
MYSQL_DATABASE=iot_agent
MYSQL_USERNAME=iot_agent
MYSQL_PASSWORD=iot_agent_local
MYSQL_ROOT_PASSWORD=root_local_only
MYSQL_PORT=3307
REDIS_PORT=6380
AGENT_MYSQL_URL='jdbc:mysql://127.0.0.1:3307/iot_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai'
AGENT_MYSQL_USERNAME=iot_agent
AGENT_MYSQL_PASSWORD=iot_agent_local
AGENT_REDIS_URL=redis://127.0.0.1:6380
# Required for durable business and Pi Session storage. No SQLite fallback.
AGENT_STORAGE_MYSQL_ENABLED=true
AGENT_STORAGE_REDIS_ENABLED=true

# Required for persisted task/plan execution identities; independent 32-byte hex key.
# Keep this key stable across restarts and backups. Java only; never pass it to Node.
TASK_CREDENTIAL_KEY=<64-hex-task-credential-key>

# Local Admin configuration encryption and boundary.
CONFIG_SECRET_KEY=<64-hex-local-only-key>
ADMIN_PASSWORD=<local-admin-password>

# Browser-derived identity for explicitly authorized local read-only probes only.
# Do not use these values in source code or logs.
